<!-- diffdrive: generic differential-drive base, two driven wheels and a passive caster ball -->
<mujoco model="diffdrive">
  <compiler angle="radian"/>
  <option timestep="0.005" integrator="implicitfast"/>
  <worldbody>
    <body name="base" pos="0 0 0.1">
      <freejoint name="root"/>
      <site name="base_site" pos="0 0 0"/>
      <geom name="base" type="cylinder" size="0.25 0.05" mass="20" rgba="0.3 0.3 0.7 1"/>
      <body name="wheel_l" pos="0 0.27 -0.02">
        <joint name="wheel_l" type="hinge" axis="0 1 0" damping="0.05"/>
        <geom type="cylinder" size="0.08 0.02" euler="1.5708 0 0" mass="1" rgba="0.1 0.1 0.1 1"/>
      </body>
      <body name="wheel_r" pos="0 -0.27 -0.02">
        <joint name="wheel_r" type="hinge" axis="0 1 0" damping="0.05"/>
        <geom type="cylinder" size="0.08 0.02" euler="1.5708 0 0" mass="1" rgba="0.1 0.1 0.1 1"/>
      </body>
      <geom name="caster" type="sphere" size="0.048" pos="0.18 0 -0.05" mass="0.2" friction="0.01 0.001 0.0001"/>
      <geom name="caster_rear" type="sphere" size="0.048" pos="-0.18 0 -0.05" mass="0.2" friction="0.01 0.001 0.0001"/>
    </body>
  </worldbody>
  <contact>
    <exclude body1="base" body2="wheel_l"/>
    <exclude body1="base" body2="wheel_r"/>
  </contact>
  <actuator>
    <!-- wheel angular velocity targets, rad/s -->
    <velocity name="wheel_l" joint="wheel_l" kv="1" ctrlrange="-15 15" forcerange="-10 10"/>
    <velocity name="wheel_r" joint="wheel_r" kv="1" ctrlrange="-15 15" forcerange="-10 10"/>
  </actuator>
</mujoco>
