<!-- omni: holonomic base modelled as planar x, y, yaw joints with velocity actuators -->
<mujoco model="omni">
  <compiler angle="radian"/>
  <option timestep="0.005" integrator="implicitfast"/>
  <worldbody>
    <body name="base" pos="0 0 0.1">
      <joint name="base_x" type="slide" axis="1 0 0" damping="1"/>
      <joint name="base_y" type="slide" axis="0 1 0" damping="1"/>
      <joint name="base_yaw" type="hinge" axis="0 0 1" damping="0.5"/>
      <site name="base_site" pos="0 0 0"/>
      <geom name="base" type="box" size="0.3 0.25 0.08" mass="25" rgba="0.3 0.6 0.3 1" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
  <actuator>
    <!-- base velocity targets: m/s for x, y and rad/s for yaw -->
    <velocity name="base_x" joint="base_x" kv="200" ctrlrange="-1.5 1.5" forcerange="-300 300"/>
    <velocity name="base_y" joint="base_y" kv="200" ctrlrange="-1.5 1.5" forcerange="-300 300"/>
    <velocity name="base_yaw" joint="base_yaw" kv="50" ctrlrange="-2 2" forcerange="-100 100"/>
  </actuator>
</mujoco>
